{
  "name": "aipr-operations-desktop",
  "version": "1.0.79",
  "author": "千寻",
  "description": "千寻 品牌通用达人运营桌面系统（macOS Apple Silicon / Windows x64 双平台构建）",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "dependencies": {},
  "scripts": {
    "mac:build": "npm run verify && npm --prefix frontend run build && electron-builder --mac dmg zip --arm64",
    "mac:dir": "npm --prefix frontend run build && electron-builder --mac dir --arm64",
    "win:build": "npm run runtime:windows && npm run verify && npm --prefix frontend run build && electron-builder --win nsis portable --x64 --config.directories.output=release-windows",
    "win:dir": "npm run runtime:windows && npm --prefix frontend run build && electron-builder --win dir --x64 --config.directories.output=release-windows",
    "test:backend": "node scripts/test-backend.cjs",
    "test:desktop": "node --test electron/*.test.cjs",
    "test:frontend": "npm --prefix frontend test",
    "verify": "npm run test:desktop && npm run test:frontend && npm --prefix frontend run typecheck && npm run test:backend",
    "mac:package": "bash scripts/package-mac.sh",
    "runtime:windows": "node scripts/check-windows-runtime.cjs"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.aipr.operations.desktop",
    "productName": "千寻",
    "asar": true,
    "directories": {
      "output": "release-macos"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/test_*.py",
          "!**/*.pyc"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "artifactName": "Qianxun-Mac-M1-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "runtime/macos-arm64",
          "to": "runtime/macos-arm64",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "千寻 ${version}",
      "artifactName": "Qianxun-Mac-M1-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Qianxun-Win-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "runtime/windows-x64",
          "to": "runtime/windows-x64",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "scripts/windows-runtime-smoke.py",
          "to": "diagnostics/windows-runtime-smoke.py"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "千寻",
      "artifactName": "Qianxun-Win-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Qianxun-Win-Portable-${version}-${arch}.${ext}"
    }
  }
}
